x = 1;
y = "Hello";
z = "World";
good = true;
bad = false;

arr = [1, 3, 9, 8,100, 1, 68666];
names = ["alice", "bob", "jane"];


print(x, y, z, good, bad);

if x != 1 {
    print("not one");
}

if x == 1 && good {
    print("good");
}

if x == 0 || bad {
    print("not good");
}

fn fib(n) {
    if n == 1 || n == 2 {
        return 1;
    }

    return fib(n - 2) + fib(n - 1);
}

fn filter(arr) {
    new_arr = [];
    for idx = 0; idx < arrlen(arr); idx++ {
        if arr[idx] % 3 == 0 {
            append(new_arr, arr[idx]);
        }
    }
    return new_arr;
}

fn names_len(names) {
    names_len = [];
    for idx = 0; idx < arrlen(names); idx++ {
         append(names_len, strlen(names[idx]));
    }
    return names_len;
}

fn print_nums(arr, n, end) {
    for idx = 0; idx < 7; idx++ {
        if arr[idx] == 0 {
            continue;
        }

        if arr[idx] == end {
            print("meet ", end, "print stop");
            break;
        }

        if arr[idx] % n == 0 {
           print(arr[idx]);
        }
    }
}

fn large(x, y) {
    if x > y {
        return x;
    } else {
        return y;
    }
}

fn print_num(n) {
    for idx = 0; idx < n; idx++ {
        print(idx, ":", idx+1);
    }
}

fn is_even(n) {
    if n % 2 == 0 {
        return true;
    } else {
        return false;
    }
}

fn split_whitespace(text) {
    words = [];
    word = "";

    for idx = 0; idx < strlen(text); idx++ {
        ch = text[idx];
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            if strlen(word) > 0 {
                append(words, word);
                word = "";
            }
        } else {
            word = word + ch;
        }
    }

    if strlen(word) > 0 {
        append(words, word);
    }

    return words;
}

print(large(10, 100));
print(split_whitespace("  hello   world  "));
print(split_whitespace("hello\tworld\nfrom\rmsp"));
print(split_whitespace("hello"));
print(split_whitespace(""));
print(split_whitespace(" \t\n\r "));
