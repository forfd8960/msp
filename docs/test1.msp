print("Arithmetic precedence and grouping");
print(1 + 2 * 3);
print((1 + 2) * 3);
print((1 + 2) / (9 * 6));
print(((2 + 3) * (8 - 4)) / 2);
print(20 - 5 - 3);
print(48 / 4 / 3);
print(17 % 5 + 2 * 3);
print(2 * -3);
print(-(2 + 3));
print(+7);

