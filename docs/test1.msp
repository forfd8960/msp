print("While loops, continue, and break");
count = 0;
total = 0;
while count < 10 {
    count++;
    if count % 2 == 0 {
        continue;
    }
    if count > 7 {
        break;
    }
    total = total + count;
}
print(count, total);
while false {}

print("Nested loops and assignment updates");
products = [];
for outer = 1; outer <= 3; outer++ {
    for inner = 1; inner <= 2; inner = inner + 1 {
        append(products, outer * inner);
    }
}
print(products);

print("Functions, nested calls, and early returns");
fn unused() {}
fn notify(message) {
    print(message);
    return;
}
fn add(a, b) {
    return a + b;
}
fn sum_values(items) {
    result = 0;
    for i = 0; i < arrlen(items); i++ {
        result = result + items[i];
    }
    return result;
}
fn factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}
fn find_first(items, target) {
    for i = 0; i < arrlen(items); i++ {
        if items[i] == target {
            return i;
        }
    }
    return null;
}
notify("ready");
print(add(add(1, 2), add(3, 4)));
print(sum_values([1, 2, 3, 4]));
print(sum_values([]));
print(factorial(5));
print(find_first([10, 20, 30], 20));
print(find_first([], 20));
